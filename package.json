{
  "name": "beaconos",
  "version": "1.1.0",
  "description": "An open-source operating system and management platform for Minecraft servers.",
  "author": "CrossbowCraft13",
  "license": "MIT",
  "homepage": "https://github.com/CrossbowCraft13/BeaconOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrossbowCraft13/BeaconOS.git"
  },
  "bugs": {
    "url": "https://github.com/CrossbowCraft13/BeaconOS/issues"
  },
  "keywords": [
    "minecraft",
    "server",
    "minecraft-server",
    "cli",
    "beaconos",
    "typescript"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "beaconos": "dist/index.js"
  },
  "files": [
    "dist/",
    "beacon/",
    "scripts/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc && node scripts/copy-dashboard-assets.js",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.2.0",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  }
}
