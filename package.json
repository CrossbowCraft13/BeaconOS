{
  "name": "beaconos",
  "version": "0.5.0-beta",
  "description": "An open-source operating system and management platform for Minecraft servers.",
  "author": "CrossbowCraft13",
  "license": "MIT",
  "homepage": "https://github.com/CrossbowCraft13/BeaconOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/CrossbowCraft13/BeaconOS.git"
  },
  "bugs": {
    "url": "https://github.com/CrossbowCraft13/BeaconOS/issues"
  },
  "keywords": [
    "minecraft",
    "server",
    "minecraft-server",
    "cli",
    "beaconos",
    "typescript"
  ],
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "beaconos": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-dashboard-assets.js",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "vitest": "^2.1.0"
  }
}
